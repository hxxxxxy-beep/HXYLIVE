# HXYLIVE server configuration
COMPOSE_PROJECT_NAME=hxylive
HOST_PORT=8081
PORT=8080
HOST_DATA_DIR=/opt/hxylive/data
# SSD mount for hot .ts staging (separate from HOST_DATA_DIR on dual-disk VPS).
HOST_STAGING_DIR=/opt/hxylive/staging
TZ=Asia/Shanghai

# WAN access plane (VPS host). Default: VLESS-Reality on :443 and public :8080 closed.
# Set ENABLE_REALITY=0 for naked public :8080 (not recommended for China Mac bulk sync).
# Confirm REALITY_DEST with the user after deploy/recommend-reality-dest.sh (host only).
ENABLE_REALITY=1
REALITY_DEST=
REALITY_PUBLIC_HOST=
# Optional overrides (leave empty to auto-generate on first install-reality.sh):
REALITY_UUID=
REALITY_SHORT_ID=

# Protect the web interface. Set a strong unique value before exposing the site.
PASSWORD=

# Twitch Helix API (required for Twitch discovery and live metadata)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_GAME_ID=509659

# YouTube Data API (required for YouTube discovery and live metadata)
YOUTUBE_API_KEY=
YOUTUBE_LIVE_QUERY=asmr

# Recording
OUTPUT_DIR=/data
STAGING_DIR=/staging
FFMPEG_PATH=ffmpeg
HLS_TIME=4
HLS_LIST_SIZE=6
RECORD_SEGMENT_DURATION_MINUTES=30
RECORD_SEGMENT_SIZE_MB=0
AUTO_RECORD_USERS=
CB_RESOLVER_ENABLED=true

# Optional provider login
CHATURBATE_USERNAME=
CHATURBATE_PASSWORD=

# Optional outbound proxy used by HXYLIVE provider requests
HXYLIVE_PROXY_URL=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,flaresolverr

# Optional features
HXYLIVE_DNS_CACHE=false
HXYLIVE_MEDIA_IMPORTS=false
HXYLIVE_DOWNLOAD_LINK_TTL_SECONDS=21600

# GitHub release/update metadata
HXYLIVE_GITHUB_REPOSITORY=hxxxxxy-beep/HXYLIVE
HXYLIVE_DOCKER_IMAGE=ghcr.io/hxxxxxy-beep/hxylive

# Automatic Docker updates are intentionally disabled. Enabling them additionally
# requires PASSWORD and an explicit /var/run/docker.sock mount.
HXYLIVE_ALLOW_DOCKER_UPDATE=false
